# ---------------------------------------------------------------------------
# SentinelMCP Demo — upstream MCP echo server
# ---------------------------------------------------------------------------
FROM golang:1.26-alpine AS builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o upstream ./cmd/upstream

FROM alpine:3.21
RUN apk add --no-cache netcat-openbsd
COPY --from=builder /build/upstream /usr/local/bin/upstream
EXPOSE 3001
ENTRYPOINT ["upstream"]
