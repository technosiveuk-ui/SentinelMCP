# ---------------------------------------------------------------------------
# SentinelMCP Demo — test client
# ---------------------------------------------------------------------------
FROM golang:1.26-alpine AS builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o testclient ./cmd/testclient

FROM alpine:3.21
COPY --from=builder /build/testclient /usr/local/bin/testclient
ENTRYPOINT ["testclient"]
